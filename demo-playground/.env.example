# Python execution server URL (local or remote)
PYTHON_SERVER_URL=http://localhost:8000

# Optional auth for a remote Alkahest server (Bearer token; WebSocket uses ?token=)
ALKAHEST_SERVER_TOKEN=

# Math tab endpoints (/math, /math/interpret). They never execute Python, so they
# can be opened without the token while the kernel endpoints stay protected.
# ALKAHEST_MATH_PUBLIC=1
# Per-request limits for the Math tab (defaults shown).
# ALKAHEST_MATH_TIMEOUT_S=15       # hard wall clock; the worker process is killed
# ALKAHEST_MATH_WALL_MS=8000       # Alkahest's cooperative Budget(wall_ms=...)
# ALKAHEST_MATH_MEMORY_MB=2048     # RLIMIT_AS of the worker; Budget(max_bytes) is half
# ALKAHEST_MATH_CONCURRENCY=2      # simultaneous Math computations

# Next.js public env (exposed to browser)
NEXT_PUBLIC_PYTHON_WS_URL=ws://localhost:8000
NEXT_PUBLIC_PYTHON_HTTP_URL=http://localhost:8000
